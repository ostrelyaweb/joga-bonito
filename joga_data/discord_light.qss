/* Shift — modern light theme
   Mirrors discord_dark.qss with a refined paper-white palette.

   Surfaces (lowest → highest)
     Canvas     #FAFAFB   window background
     Surface-1  #F3F4F6   sidebar
     Surface-2  #FFFFFF   cards, search, preview
     Surface-3  #F0F1F4   row hover
     Surface-4  #E6E8EE   row selected / pressed

   Borders
     Hairline   rgba(0,0,0,0.06)
     Strong     rgba(0,0,0,0.10)

   Text
     Primary    #14151A
     Secondary  #5B6170
     Tertiary   #8B91A1
     Disabled   #C7CBD3

   Accent (indigo)
     Accent     #6366F1
     AccentHi   #4F52E0
     AccentLo   #4338CA
     AccentMute rgba(99,102,241,0.10)

   Semantic
     Success    #10B981
     Danger     #EF4444
*/

* {
    font-family: "Inter", "SF Pro Display", "Segoe UI Variable", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #14151A;
}

QMainWindow#MainWindow,
QWidget#Central {
    background: #FAFAFB;
}

/* ---------- Title bar ---------- */

#TitleBar {
    background: #FAFAFB;
    border-bottom: 1px solid rgba(0,0,0,0.06);
}

#TitleLabel {
    font-size: 13px;
    font-weight: 600;
    color: #14151A;
    letter-spacing: 0.2px;
}
#TitleCredit {
    font-size: 12px;
    color: #5B6170;
    letter-spacing: 0.3px;
}

QToolButton#BtnSettings, QToolButton#BtnMin, QToolButton#BtnMax, QToolButton#BtnClose {
    background: transparent;
    border: none;
    color: #5B6170;
    border-radius: 6px;
    min-width: 28px; max-width: 28px;
    min-height: 24px; max-height: 24px;
    font-size: 13px;
}
QToolButton#BtnSettings:hover, QToolButton#BtnMin:hover, QToolButton#BtnMax:hover {
    background: #F0F1F4;
    color: #14151A;
}

#ThemeIcon {
    color: #5B6170;
    font-size: 13px;
    padding: 0 1px;
}

QToolButton#BtnLang {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 6px;
    min-width: 36px; max-width: 36px;
    min-height: 22px; max-height: 22px;
    padding: 2px 4px 2px 4px;
}
QToolButton#BtnLang:hover { background: #F0F1F4; border: 1px solid rgba(0,0,0,0.22); }
QToolButton#BtnLang::menu-indicator { image: none; width: 0; }
QToolButton#BtnLang::menu-button { width: 0; border: none; }

QMenu#LangMenu {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 4px;
    color: #14151A;
}
QMenu#LangMenu::item {
    background: transparent;
    padding: 6px 12px 6px 8px;
    border-radius: 6px;
    min-width: 110px;
}
QMenu#LangMenu::item:selected {
    background: rgba(99,102,241,0.14);
    color: #14151A;
}
QMenu#LangMenu::icon { padding-right: 8px; padding-left: 4px; }
QToolButton#BtnClose:hover { background: #EF4444; color: #FFFFFF; }

/* ---------- Body / panes ---------- */

#Body              { background: #FAFAFB; }
/* Inverted: sidebar is the darker surface; main panels are the lighter
   canvas. Single solid color, no gradient.
   NavRail + CategoryPanel jointly replace the old Sidebar column. */
#Sidebar {
    background: #E2E5EA;
    border-right: 1px solid rgba(0,0,0,0.08);
    min-width: 240px; max-width: 240px;
}
#NavRail {
    background: #E2E5EA;
    border-right: 1px solid rgba(0,0,0,0.08);
}
#CategoryPanel {
    background: #E2E5EA;
    border-right: 1px solid rgba(0,0,0,0.08);
    min-width: 200px; max-width: 200px;
}
#ListPanel         { background: #FAFAFB; }
#DetailPane        { background: #FAFAFB; }
#ActiveSwapsView   { background: #FAFAFB; }
#SwapPickerView    { background: #FAFAFB; }
#BallView          { background: #FAFAFB; }
#HudMeterView      { background: #FAFAFB; }
#DecalView         { background: #FAFAFB; }

#SidebarSectionHeader {
    color: #8B91A1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 18px 14px 6px 14px;
    background: transparent;
}
#SidebarHairline { background: rgba(0,0,0,0.08); margin: 0 16px; }

/* Sidebar / CategoryPanel list rows — pill-shaped, indigo accent on selection */
#Sidebar QListView,
#CategoryPanel QListView { background: transparent; border: none; padding: 0 0 8px 0; outline: 0; }
#Sidebar QListView::item,
#CategoryPanel QListView::item {
    padding: 7px 10px;
    border-radius: 8px;
    margin: 1px 8px;
    color: #5B6170;
    min-height: 22px;
}
#Sidebar QListView::item:hover,
#CategoryPanel QListView::item:hover    { background: #E6E8EE; color: #14151A; }
#Sidebar QListView::item:selected,
#CategoryPanel QListView::item:selected {
    background: rgba(99,102,241,0.10);
    color: #14151A;
}

/* ---------- NavRail buttons ---------- */

QToolButton#NavRailButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    color: #5B6170;
    text-align: left;
}
QToolButton#NavRailButton:hover {
    background: rgba(0,0,0,0.04);
    color: #14151A;
}
QToolButton#NavRailButton:checked {
    background: rgba(99,102,241,0.12);
    color: #14151A;
}

/* ---------- BallCard ---------- */

#BallCard {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.06);
}
#BallCardName { color: #14151A; font-weight: 600; }

/* ---------- DecalCard (mirror BallCard) ---------- */

#DecalCard {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.06);
}
#DecalCardName    { color: #14151A; font-weight: 600; }
#DecalCardRequire { color: rgba(20,21,26,0.55); font-size: 12px; }

/* ---------- WorkshopCard (mirror DecalCard) ---------- */

#WorkshopView { background: #FAFAFB; }
#WorkshopCard {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.06);
}
#WorkshopCard[active="true"] { border: 1px solid #2EA44F; }
#WorkshopCardName   { color: #14151A; font-weight: 600; }
#WorkshopCardAuthor { color: rgba(20,21,26,0.55); font-size: 12px; }
#WorkshopCardActiveBadge {
    color: #2EA44F; font-weight: 700; font-size: 11px;
    letter-spacing: 1px; padding: 2px 8px;
}
#WorkshopViewTitle       { color: #14151A; font-size: 18px; font-weight: 600; }
#WorkshopViewActiveLabel { color: rgba(20,21,26,0.55); font-size: 12px; }
#WorkshopViewStatus      { color: rgba(20,21,26,0.55); font-size: 12px; }

/* Action buttons on Ball / Decal cards. Green = commit (Apply); red =
   destructive (Remove + the global Restore buttons + the per-card
   Restore state). See apple_dark.qss for the `[active="true"]` rationale. */
#BallCardApply, #DecalCardApply,
#WorkshopCardApply, #WorkshopCardDownload {
    background: #2EA44F; color: white; border: 1px solid #2EA44F; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#BallCardApply:hover, #DecalCardApply:hover,
#WorkshopCardApply:hover, #WorkshopCardDownload:hover { background: #2C974B; border: 1px solid #2C974B; }
#BallCardApply:disabled, #DecalCardApply:disabled,
#WorkshopCardApply:disabled, #WorkshopCardDownload:disabled {
    background: rgba(46,164,79,0.45); border: 1px solid rgba(46,164,79,0.45); color: #FFFFFF;
}
#DecalCardApply[active="true"] { background: #DC2626; border: 1px solid #DC2626; }
#DecalCardApply[active="true"]:hover { background: #B91C1C; border: 1px solid #B91C1C; }
#BallCardRemove, #DecalCardRemove,
#WorkshopCardDelete,
#BallRestoreDefault, #DecalRestoreAll, #WorkshopRestoreOriginal {
    background: #DC2626; color: white; border: 1px solid #DC2626; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#BallCardRemove:hover, #DecalCardRemove:hover,
#WorkshopCardDelete:hover,
#BallRestoreDefault:hover, #DecalRestoreAll:hover, #WorkshopRestoreOriginal:hover { background: #B91C1C; border: 1px solid #B91C1C; color: #FFFFFF; }
/* Disabled = nothing to revert/restore. See apple_dark.qss. */
#BallRestoreDefault:disabled, #DecalRestoreAll:disabled, #WorkshopRestoreOriginal:disabled {
    background: rgba(220,38,38,0.35); border: 1px solid rgba(220,38,38,0.35); color: #FFFFFF;
}

/* Preset card actions — see apple_dark.qss for the rationale. */
#PresetLoad, #PresetLoad:disabled {
    background: #2EA44F; color: white; border: 1px solid #2EA44F; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#PresetLoad:hover { background: #2C974B; border: 1px solid #2C974B; }
#PresetRename {
    background: #2563EB; color: white; border: 1px solid #2563EB; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#PresetRename:hover { background: #1D4ED8; border: 1px solid #1D4ED8; color: #FFFFFF; }

/* Card-grid scroll area: inherit the parent view's background. */
#BallView QScrollArea,
#DecalView QScrollArea,
#HudMeterView QScrollArea,
#WorkshopView QScrollArea,
#BallView QAbstractScrollArea,
#DecalView QAbstractScrollArea,
#HudMeterView QAbstractScrollArea,
#WorkshopView QAbstractScrollArea {
    background: transparent;
    border: none;
}
#BallView QScrollArea > QWidget > QWidget,
#DecalView QScrollArea > QWidget > QWidget,
#WorkshopView QScrollArea > QWidget > QWidget,
#HudMeterView QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* HudMeterCard — same look as BallCard / DecalCard on light theme. */
#HudMeterCard {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.06);
}
#HudMeterCardName { color: #1C1C1E; font-weight: 600; }
#HudMeterCardApply {
    background: #2EA44F; color: white; border: 1px solid #2EA44F; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#HudMeterCardApply:hover { background: #2C974B; border: 1px solid #2C974B; }
#HudMeterCardApply[active="true"] { background: #DC2626; border: 1px solid #DC2626; }
#HudMeterCardApply[active="true"]:hover { background: #B91C1C; border: 1px solid #B91C1C; }
#HudMeterCardRemove {
    background: #DC2626; color: white; border: 1px solid #DC2626; border-radius: 8px;
    padding: 8px 14px; font-weight: 600;
}
#HudMeterCardRemove:hover { background: #B91C1C; border: 1px solid #B91C1C; color: #FFFFFF; }

/* ---------- Search field ---------- */

QLineEdit#Search {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px 6px 32px;
    color: #14151A;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
    min-height: 22px;
}
QLineEdit#Search:focus {
    background: #FFFFFF;
    border: 1px solid #6366F1;
}

QLineEdit#WorkshopSearch {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
}
QLineEdit#WorkshopSearch:focus {
    border: 1px solid #6366F1;
}

/* ---------- Item list rows ---------- */

#ListPanel QListView,
#SwapPickerView QListView { background: transparent; border: none; outline: 0; }
#ListPanel QListView::item,
#SwapPickerView QListView::item {
    padding: 9px 12px;
    border-radius: 8px;
    margin: 2px 12px;
    color: #14151A;
    min-height: 26px;
}
#ListPanel QListView::item:hover,
#SwapPickerView QListView::item:hover    { background: #F0F1F4; }
#ListPanel QListView::item:selected,
#SwapPickerView QListView::item:selected { background: #E6E8EE; }

/* ---------- Detail pane labels ---------- */

#DetailTitle  { font-size: 22px; font-weight: 700; color: #14151A; letter-spacing: -0.3px; }
#DetailStatus { font-size: 13px; color: #5B6170; }
#DetailMeta   { font-size: 11px; font-weight: 700; color: #8B91A1; letter-spacing: 1px; }

#Preview {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
}

/* ---------- Active swaps cards ---------- */

#ActiveSwapsHeading {
    font-size: 22px;
    font-weight: 700;
    color: #14151A;
    letter-spacing: -0.3px;
}

#ActiveSwapsEmpty {
    color: #8B91A1;
    font-size: 13px;
    padding: 32px 0;
}

QWidget#DonationCard {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
}
#DonationBody { color: #14151A; font-size: 14px; }
#DonationNote { color: #B45309; font-size: 12px; font-style: italic; }
#DonationUrlBox {
    background: #F3F4F6;
    color: #4F52E0;
    font-family: "Consolas", "Menlo", monospace;
    font-size: 13px;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 10px 12px;
}

/* ---------- Upgrade / upsell (Lite vs Plus) ---------- */
#UpsellSubtitle { color: #5B6070; font-size: 13px; }
QWidget#UpsellCardPlus {
    background: #FFFFFF;
    border: 2px solid #6366F1;
    border-radius: 12px;
}
#UpsellTierName     { color: #14151A; font-size: 18px; font-weight: 700; }
#UpsellTierNamePlus { color: #4F52E0; font-size: 18px; font-weight: 700; }
#UpsellTagline      { color: #8B91A1; font-size: 12px; }
#UpsellBadge {
    background: #6366F1; color: #FFFFFF;
    font-size: 10px; font-weight: 700; letter-spacing: 0.5px;
    border-radius: 8px; padding: 2px 8px;
}
#UpsellFeature      { color: #1F2430; font-size: 13px; }
#UpsellFeatureMuted { color: #A7ADBA; font-size: 13px; }
#UpsellCheck        { color: #6366F1; font-size: 14px; font-weight: 700; }
#UpsellCheckPlus    { color: #B45309; font-size: 14px; font-weight: 700; }
#UpsellCross        { color: #A7ADBA; font-size: 14px; font-weight: 700; }
#UpsellDivider      { color: #8B91A1; font-size: 10px; font-weight: 700; letter-spacing: 0.6px; }
#UpsellFootnote     { color: #8B91A1; font-size: 12px; }

QWidget#SwapCard {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
}
QWidget#SwapCard:hover {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.12);
}

#SwapCardLabel       { color: #14151A; font-size: 14px; font-weight: 500; }
#SwapCardArrow       { color: #8B91A1; font-size: 13px; padding: 0 6px; }
#SwapCardSourceLabel { color: #5B6170; font-size: 14px; font-weight: 500; }
#SwapCardCaption     { color: #8B91A1; font-size: 11px; letter-spacing: 0.6px; font-weight: 600; }

/* ---------- Buttons ---------- */

QPushButton {
    background: #FFFFFF;
    color: #14151A;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 22px;
    font-weight: 500;
}
QPushButton:hover  {
    background: #F0F1F4;
    border: 1px solid rgba(0,0,0,0.16);
}
QPushButton:pressed {
    background: #E6E8EE;
}
QPushButton:disabled {
    color: #C7CBD3;
    background: #F3F4F6;
    border: 1px solid rgba(0,0,0,0.04);
}

QPushButton[primary="true"] {
    background: #6366F1;
    color: #FFFFFF;
    border: 1px solid #6366F1;
    font-weight: 600;
}
QPushButton[primary="true"]:hover  { background: #4F52E0; border: 1px solid #4F52E0; }
QPushButton[primary="true"]:pressed { background: #4338CA; border: 1px solid #4338CA; }

/* Destructive actions (Delete preset, Revert swap, Quit update dialog).
   Solid red matches the Restore-default / Remove buttons on the Ball /
   Decal cards so all destructive UI looks the same. */
QPushButton[danger="true"] {
    background: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
}
QPushButton[danger="true"]:hover {
    background: #B91C1C;
    border: 1px solid #B91C1C;
    color: #FFFFFF;
}
QPushButton[danger="true"]:disabled {
    background: rgba(220,38,38,0.35);
    color: #FFFFFF;
    border: 1px solid rgba(220,38,38,0.35);
}

/* ---------- Scrollbar ---------- */

QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 0; }
QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.12);
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: rgba(0,0,0,0.22); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: transparent; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 0; background: transparent; }

QToolTip {
    background: #14151A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

#SwapWarning {
    color: #B45309;
    background: rgba(251,191,36,0.14);
    border: 1px solid rgba(180,83,9,0.30);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 12px;
    font-style: italic;
}

QDialog, QMessageBox {
    background: #FAFAFB;
    color: #14151A;
}

QDialog QLabel { color: #14151A; background: transparent; }
QDialog QLabel#AboutLabel { color: #8B91A1; font-size: 12px; }
QDialog QFormLayout QLabel { color: #5B6170; }

QComboBox {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    min-height: 22px;
}
QComboBox:hover { border: 1px solid rgba(0,0,0,0.18); }
QComboBox:focus { border: 1px solid #6366F1; }
QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 0;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border: none;
}
/* See discord_dark.qss for the rationale — active-swaps filter has no
   indicator, the padding doubles as a click target. */
QComboBox#ActiveSwapsFilter::drop-down,
QComboBox#ActiveSwapsCategoryFilter::drop-down { width: 0; border: none; }
QComboBox#ActiveSwapsFilter::down-arrow,
QComboBox#ActiveSwapsCategoryFilter::down-arrow { image: none; width: 0; height: 0; border: none; }
QComboBox#ActiveSwapsFilter,
QComboBox#ActiveSwapsCategoryFilter { padding-right: 12px; }
QComboBox QAbstractItemView,
QListView#WorkshopSortView {
    background: #FFFFFF;
    color: #14151A;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(99,102,241,0.14);
    selection-color: #14151A;
    outline: 0;
}
QComboBox QAbstractItemView::item,
QListView#WorkshopSortView::item {
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
}

/* QKeySequenceEdit + QSpinBox — match the QComboBox visual. */
QKeySequenceEdit { background: transparent; border: none; }
QKeySequenceEdit QLineEdit {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    min-height: 22px;
    selection-background-color: rgba(99,102,241,0.22);
    selection-color: #14151A;
}
QKeySequenceEdit QLineEdit:hover  { border: 1px solid rgba(0,0,0,0.18); }
QKeySequenceEdit QLineEdit:focus  { border: 1px solid #6366F1; }
QLineEdit#ControllerCaptureLineEdit {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    min-height: 22px;
    selection-background-color: rgba(99,102,241,0.22);
    selection-color: #14151A;
}
QLineEdit#ControllerCaptureLineEdit:hover { border: 1px solid rgba(0,0,0,0.18); }
QLineEdit#ControllerCaptureLineEdit:focus { border: 1px solid #6366F1; }
QLineEdit#KeyCaptureLineEdit {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    min-height: 22px;
    selection-background-color: rgba(99,102,241,0.22);
    selection-color: #14151A;
}
QLineEdit#KeyCaptureLineEdit:hover { border: 1px solid rgba(0,0,0,0.18); }
QLineEdit#KeyCaptureLineEdit:focus { border: 1px solid #6366F1; }
QSpinBox {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 8px;
    padding: 6px 12px;
    color: #14151A;
    min-height: 22px;
}
QSpinBox:hover  { border: 1px solid rgba(0,0,0,0.18); }
QSpinBox:focus  { border: 1px solid #6366F1; }

QFrame[frameShape="4"] {
    color: rgba(0,0,0,0.10);
    background: rgba(0,0,0,0.10);
    max-height: 1px;
    border: none;
}

/* Tracker tab + Tutorial tab — shared shell (see apple_dark.qss). */
#TrackerView,
#TutorialView { background: #FAFAFB; }

QTabWidget#TrackerTabs::pane,
QTabWidget#TutorialTabs::pane {
    background: #FAFAFB;
    border: none;
    border-top: 1px solid rgba(0,0,0,0.08);
}
QTabWidget#TrackerTabs > QWidget,
QTabWidget#TrackerTabs QScrollArea,
QTabWidget#TrackerTabs QScrollArea > QWidget,
QTabWidget#TrackerTabs QScrollArea > QWidget > QWidget,
QTabWidget#TutorialTabs > QWidget,
QTabWidget#TutorialTabs QScrollArea,
QTabWidget#TutorialTabs QScrollArea > QWidget,
QTabWidget#TutorialTabs QScrollArea > QWidget > QWidget {
    background: #FAFAFB;
}
QTabWidget#TrackerTabs QTabBar,
QTabWidget#TutorialTabs QTabBar { background: transparent; }
QTabWidget#TrackerTabs QTabBar::tab,
QTabWidget#TutorialTabs QTabBar::tab {
    background: transparent;
    color: #5B6170;
    padding: 8px 18px;
    border: none;
    margin-right: 4px;
    font-weight: 500;
}
QTabWidget#TrackerTabs QTabBar::tab:hover,
QTabWidget#TutorialTabs QTabBar::tab:hover    { color: #14151A; }
QTabWidget#TrackerTabs QTabBar::tab:selected,
QTabWidget#TutorialTabs QTabBar::tab:selected {
    color: #14151A;
    border-bottom: 2px solid #6366F1;
}
#TrackerCard {
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
}
#TrackerStatusPill {
    background: #F0F1F4;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
}
#TrackerStatusPill[state="connected"]    { color: #15803D; }
#TrackerStatusPill[state="disconnected"] { color: #5B6170; }
#TrackerStatusPill[state="connecting"]   { color: #B45309; }
#TrackerHandle      { color: #14151A; font-weight: 500; }
#TrackerMmrLine     { color: #14151A; font-family: "Consolas", "Menlo", monospace; }
#TrackerTeamLabel   { color: #14151A; font-weight: 600; padding-top: 6px; }

/* Hero MMR card — discord-light variant. White card, blurple accents. */
#TrackerMmrHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFFFFF, stop:1 #F4F4FB);
    border: 1px solid rgba(88,101,242,0.20);
    border-left: 4px solid rgba(0,0,0,0.12);
    border-radius: 14px;
}
#TrackerMmrHero[tier="bronze"]         { border-left: 4px solid #8C4F22; }
#TrackerMmrHero[tier="silver"]         { border-left: 4px solid #8E96A0; }
#TrackerMmrHero[tier="gold"]           { border-left: 4px solid #C99020; }
#TrackerMmrHero[tier="platinum"]       { border-left: 4px solid #28A89F; }
#TrackerMmrHero[tier="diamond"]        { border-left: 4px solid #2F70E0; }
#TrackerMmrHero[tier="champion"]       { border-left: 4px solid #8458E6; }
#TrackerMmrHero[tier="grand-champion"] { border-left: 4px solid #D8424B; }
#TrackerMmrHero[tier="ssl"]            { border-left: 4px solid #C92AA1; }
#TrackerRankIcon { background: transparent; }
#TrackerMmrShowing {
    color: #5B6170;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
}
#TrackerRankName {
    color: #14151A;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.2px;
}
#TrackerMmrNumber {
    color: #14151A;
    font-size: 32px;
    font-weight: 800;
    font-family: "Segoe UI Variable", "Inter", "SF Pro Display", sans-serif;
}
#TrackerMmrPeak {
    color: #5B6170;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding-bottom: 6px;
}
#TrackerPlaylistTag {
    background: rgba(88,101,242,0.10);
    color: #3A40C9;
    border: 1px solid rgba(88,101,242,0.40);
    border-radius: 14px;
    padding: 5px 14px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1.6px;
    min-width: 44px;
}
#TrackerScore {
    color: #14151A;
    font-size: 20px;
    font-weight: 700;
    padding: 0;
    letter-spacing: 2px;
}
#TrackerTeamBlue {
    color: #1D4ED8;
    font-weight: 700;
    padding-top: 8px;
}
#TrackerTeamOrange {
    color: #C2410C;
    font-weight: 700;
    padding-top: 8px;
}
#TrackerPlayerRow   { color: #5B6170; font-family: "Consolas", "Menlo", monospace; }
#TrackerMatchEmpty  { color: #8B91A1; padding: 12px 0; font-style: italic; }
#TrackerOverlayHint { color: #B45309; font-size: 12px; padding: 0 2px 8px 2px; }
#TrackerResetSession {
    background: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}
#TrackerResetSession:hover { background: #B91C1C; border: 1px solid #B91C1C; }
#TrackerPlaylistBtn {
    background: transparent;
    color: #5B6170;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 6px;
    padding: 4px 14px;
    font-weight: 600;
    min-width: 40px;
}
#TrackerPlaylistBtn:hover { background: rgba(0,0,0,0.04); color: #14151A; }
#TrackerPlaylistBtn:checked {
    background: rgba(99,102,241,0.14);
    color: #14151A;
    border: 1px solid rgba(99,102,241,0.40);
}
#TrackerBlueCard {
    background: rgba(29,78,216,0.06);
    border: 1px solid rgba(29,78,216,0.20);
    border-radius: 8px;
}
#TrackerOrangeCard {
    background: rgba(194,65,12,0.06);
    border: 1px solid rgba(194,65,12,0.20);
    border-radius: 8px;
}
#TrackerColHeader {
    color: #5B6170;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding-bottom: 4px;
}
